# Copy to playground/.env and fill in. Values: https://discord.com/developers/applications

# Bot > Token
BOT_TOKEN=

# General Information > Application ID
APP_ID=

# Optional: your Discord user ID, it bypasses command permissions
APP_OWNER_ID=

# The cactu-cc module (/cactu-cc login, /cactu-cc mc-scan): the Cactu backend's address and the API key of its `bot` account,
# sent with every call to the backend. Create it on the backend with `bun tools/apiKeys.ts create bot "Cactu Discord bot"` (shown once)
CACTU_BACKEND_ORIGIN=http://localhost:3001
CACTU_BACKEND_API_KEY=

# Optional: the Cactu website's address, for links to the satellite scans (none without it)
CACTU_FRONTEND_ORIGIN=http://localhost:3000

# The secret the Cactu backend sends when it calls the bot (the backend's CACTU_BOT_SECRET, the same value, 32+ characters).
# Never the same value as CACTU_BACKEND_API_KEY: a leak then exposes one direction only, and each can be rotated alone
CACTU_BOT_SECRET=

# The bot's HTTP server for the Cactu backend, authorized with CACTU_BOT_SECRET above (off without either). Modules add
# endpoints to it, at /api/<namespace id>/<module name>/…, e.g. the minecraft module's POST /api/<guild id>/minecraft/events. The backend's CACTU_BOT_ORIGIN must point here
# (e.g. http://localhost:3002 or http://bot:3002)
CACTU_BOT_PORT=3002

# The Minecraft server's version, for its Polish language file (downloaded from Mojang into modules/minecraft/_translation/<version>/)
MINECRAFT_VERSION=
