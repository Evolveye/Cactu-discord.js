{
  "name": "cactu-discord.js",
  "version": "4.1.1",
  "description": "Transformed discord.js library into Cactu framework",
  "author": "Paweł S",
  "homepage": "https://github.com/Evolveye/Cactu-discord.js",
  "repository": "https://github.com/Evolveye/Cactu-discord.js",
  "license": "ISC",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "hello": "echo Hello. Look at here for more information https://github.com/Evolveye/Cactu-discord.js.",
    "dev": "bun --env-file=playground/.env playground/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "keywords": [
    "codecactu",
    "cactu",
    "discord",
    "js",
    "discord.js",
    "cactu-discord.js",
    "bot",
    "framework",
    "automated"
  ],
  "dependencies": {
    "canvas": "^3.2.3",
    "discord.js": "^14.28.1"
  },
  "devDependencies": {
    "@types/node": "^22",
    "eslint": "^9",
    "eslint-config-eye": "^2.1.1",
    "typescript": "~6.0.3"
  }
}
